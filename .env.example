SF_APP__HOST=127.0.0.1
SF_APP__PORT=8091
SF_APP__RELOAD=false
SF_APP__LOG_LEVEL=INFO
SF_APP__REQUEST_CAPACITY=64
SF_APP__REQUEST_WAIT_SECONDS=0.25
SF_APP__TRUSTED_PROXY_IPS=127.0.0.1

SF_DATABASE__HOST=127.0.0.1
SF_DATABASE__PORT=15432
SF_DATABASE__NAME=supportflow
SF_DATABASE__USER=supportflow
SF_DATABASE__PASSWORD=change-this-local-password
SF_DATABASE__POOL_SIZE=5
SF_DATABASE__MAX_OVERFLOW=5
SF_DATABASE__POOL_TIMEOUT_SECONDS=3
SF_DATABASE__CONNECT_TIMEOUT_SECONDS=3
SF_DATABASE__QUERY_TIMEOUT_SECONDS=5
SF_DATABASE__HEALTH_TIMEOUT_SECONDS=2

SF_CACHE__ENABLED=true
SF_CACHE__HOST=127.0.0.1
SF_CACHE__PORT=16379
SF_CACHE__DATABASE=0
SF_CACHE__PASSWORD=
SF_CACHE__PREFIX=supportflow:v1
SF_CACHE__MAX_CONNECTIONS=16
SF_CACHE__TIMEOUT_SECONDS=0.15
SF_CACHE__COOLDOWN_SECONDS=5
SF_CACHE__LOAD_CAPACITY=8
SF_CACHE__LOAD_WAIT_SECONDS=0.25
SF_CACHE__RUN_TTL_SECONDS=3
SF_CACHE__SUMMARY_TTL_SECONDS=15

SF_AUTH__ACCESS_SECONDS=600
SF_AUTH__REFRESH_IDLE_DAYS=7
SF_AUTH__SESSION_DAYS=30
SF_AUTH__COOKIE_SECURE=false
SF_AUTH__BROWSER_SESSION_LIMIT=8
SF_AUTH__PASSWORD_WORKERS=4
SF_AUTH__LOGIN_ATTEMPTS_PER_MINUTE=20

SF_AGENT__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SF_AGENT__MODEL=qwen-max
# Task profiles inherit SF_AGENT__MODEL when blank. One Alibaba key/endpoint is shared.
SF_AGENT__CONSULTATION__MODEL=qwen-flash
SF_AGENT__CONSULTATION__CONCURRENCY=2
SF_AGENT__DRAFT_PLANNER__MODEL=qwen-flash
SF_AGENT__DRAFT_PLANNER__CONCURRENCY=2
SF_AGENT__DRAFT_WRITER__MODEL=qwen-flash
SF_AGENT__DRAFT_WRITER__CONCURRENCY=2
SF_AGENT__DRAFT_REVIEWER__MODEL=qwen-flash
SF_AGENT__DRAFT_REVIEWER__CONCURRENCY=2
SF_AGENT__REVIEW_MAX_ROUNDS=8
SF_AGENT__REVIEW_MAX_TOOLS=16
SF_AGENT__REVIEW_TOKEN_BUDGET=100000
SF_AGENT__REVIEW_RUN_SECONDS=120
SF_AGENT__API_KEY=
SF_AGENT__CAPACITY=4
SF_AGENT__TIMEOUT_SECONDS=30
SF_AGENT__RUN_SECONDS=90
SF_AGENT__SEARCH_TIMEOUT_SECONDS=6
SF_AGENT__DRAFT_MAX_ROUNDS=12
SF_AGENT__DRAFT_MAX_TOOLS=8
SF_AGENT__DRAFT_TOKEN_BUDGET=64000
SF_AGENT__DRAFT_OUTPUT_TOKENS=6000
SF_AGENT__DRAFT_SECTION_OUTPUT_TOKENS=4000
SF_AGENT__DRAFT_RUN_SECONDS=150
SF_AGENT__DRAFT_MODEL_TIMEOUT_SECONDS=60
SF_AGENT__DRAFT_HISTORY_CHARS=200000


# Completed/failed execution snapshots only; waiting human decisions are retained.
SF_AGENT__CHECKPOINT_SUCCESS_DAYS=1
SF_AGENT__CHECKPOINT_FAILURE_DAYS=7
SF_AGENT__CHECKPOINT_CLEANUP_LIMIT=25

# Durable support deadlines and periodic reconciliation. No timer depends on a login SID.
SF_RECOVERY__ENABLED=true
SF_RECOVERY__SCAN_SECONDS=15
SF_RECOVERY__BATCH_SIZE=40
SF_RECOVERY__SUPPORT_WAIT_SECONDS=180
SF_RECOVERY__SUPPORT_REPLY_WARN_SECONDS=120
SF_RECOVERY__SUPPORT_REPLY_SECONDS=300
SF_RECOVERY__SUPPORT_IDLE_SECONDS=900
SF_RECOVERY__SUPPORT_NOTICE_SECONDS=60
SF_RECOVERY__SUPPORT_EXTEND_SECONDS=300
SF_RECOVERY__STALLED_RUN_SECONDS=180
SF_RECOVERY__BUSINESS_REMIND_SECONDS=86400

# Optional explicitly approved fallback per purpose; disabled when absent.
# SF_AGENT__FALLBACKS__CONSULTATION__MODEL=<verified-model-id>
# SF_AGENT__FALLBACKS__CONSULTATION__SUPPORTS_TOOLS=true
# SF_AGENT__FALLBACKS__CONSULTATION__SUPPORTS_JSON=true
